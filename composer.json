{
    "name": "abolaradev/jalali-date-picker",
    "description": "A package for selecting Jalali dates in Livewire",
    "keywords": [
        "abolaradev",
        "laravel",
        "jalali-date-picker"
    ],
    "homepage": "https://github.com/abolaradev/jalali-date-picker",
    "license": "MIT",
    "authors": [
        {
            "name": "abolaradev",
            "email": "abolfazlebrahimi923395@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "livewire/livewire": "^4.0",
        "morilog/jalali": "^3.5",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Abolaradev\\JalaliDatePicker\\": "src/",
            "Abolaradev\\JalaliDatePicker\\Database\\Factories\\": "database/factories/"
        },
        "files":["src/helpers/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Abolaradev\\JalaliDatePicker\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@composer run prepare"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abolaradev\\JalaliDatePicker\\JalaliDatePickerServiceProvider"
            ],
            "aliases": {
                "JalaliDatePicker": "Abolaradev\\JalaliDatePicker\\Facades\\JalaliDatePicker",
                "WithJalaliDatePicker": "Abolaradev\\JalaliDatePicker\\Traits\\WithJalaliDatePicker"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
